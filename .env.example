# Required in production: any random string of 16+ characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Public address of the app, used in password-reset links. Optional locally.
APP_URL=http://localhost:4000
PORT=4000
DB_PATH=./data/folio.db

# Email (optional). Without SMTP_HOST, emails are printed to the server console
# and the app tells the user nothing was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Folio <invoices@example.com>"

# Google sign-in (optional). The button only appears when this is set.
GOOGLE_CLIENT_ID=

# Set to 1 when running behind one reverse proxy so rate limits see the real client IP.
TRUST_PROXY=

# Set to "production" when deployed (requires JWT_SECRET).
NODE_ENV=
# Set to "off" only in automated tests to disable rate limits.
RATE_LIMIT=
